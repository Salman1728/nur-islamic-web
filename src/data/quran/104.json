{"meta":{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","numberOfAyahs":9,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":6180,"juz":30,"page":601,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","en":"Woe to every scorner and mocker","tr":"Wai lul-li kulli hu mazatil-lumaza"},{"n":2,"global":6181,"juz":30,"page":601,"sajda":false,"ar":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","en":"Who collects wealth and [continuously] counts it.","tr":"Al-lazi jama'a maalaw wa'addadah"},{"n":3,"global":6182,"juz":30,"page":601,"sajda":false,"ar":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","en":"He thinks that his wealth will make him immortal.","tr":"Yahsabu anna maalahu akhladah"},{"n":4,"global":6183,"juz":30,"page":601,"sajda":false,"ar":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","en":"No! He will surely be thrown into the Crusher.","tr":"Kalla layum ba zanna fil hutamah"},{"n":5,"global":6184,"juz":30,"page":601,"sajda":false,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","en":"And what can make you know what is the Crusher?","tr":"Wa maa adraaka mal-hutamah"},{"n":6,"global":6185,"juz":30,"page":601,"sajda":false,"ar":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","en":"It is the fire of Allah, [eternally] fueled,","tr":"Narul laahil-mooqada"},{"n":7,"global":6186,"juz":30,"page":601,"sajda":false,"ar":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","en":"Which mounts directed at the hearts.","tr":"Al latee tat tali'u 'alalafidah"},{"n":8,"global":6187,"juz":30,"page":601,"sajda":false,"ar":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","en":"Indeed, Hellfire will be closed down upon them","tr":"Innaha 'alaihim moosada"},{"n":9,"global":6188,"juz":30,"page":601,"sajda":false,"ar":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","en":"In extended columns.","tr":"Fee 'amadim-mu mad dadah"}]}
