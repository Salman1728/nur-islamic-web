{"meta":{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","numberOfAyahs":8,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":6169,"juz":30,"page":600,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","en":"Competition in [worldly] increase diverts you","tr":"Al haaku mut takathur"},{"n":2,"global":6170,"juz":30,"page":600,"sajda":false,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","en":"Until you visit the graveyards.","tr":"Hatta zurtumul-maqaabir"},{"n":3,"global":6171,"juz":30,"page":600,"sajda":false,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","en":"No! You are going to know.","tr":"Kalla sawfa ta'lamoon"},{"n":4,"global":6172,"juz":30,"page":600,"sajda":false,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","en":"Then no! You are going to know.","tr":"Thumma kalla sawfa ta'lamoon"},{"n":5,"global":6173,"juz":30,"page":600,"sajda":false,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","en":"No! If you only knew with knowledge of certainty...","tr":"Kalla law ta'lamoona 'ilmal yaqeen"},{"n":6,"global":6174,"juz":30,"page":600,"sajda":false,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","en":"You will surely see the Hellfire.","tr":"Latara-wun nal jaheem"},{"n":7,"global":6175,"juz":30,"page":600,"sajda":false,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","en":"Then you will surely see it with the eye of certainty.","tr":"Thumma latara wunnaha 'ainal yaqeen"},{"n":8,"global":6176,"juz":30,"page":600,"sajda":false,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","en":"Then you will surely be asked that Day about pleasure.","tr":"Thumma latus alunna yauma-izin 'anin na'eem"}]}
