{"meta":{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","numberOfAyahs":11,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":6158,"juz":30,"page":600,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","en":"The Striking Calamity -","tr":"Al qaari'ah"},{"n":2,"global":6159,"juz":30,"page":600,"sajda":false,"ar":"مَا ٱلْقَارِعَةُ","en":"What is the Striking Calamity?","tr":"Mal qaariah"},{"n":3,"global":6160,"juz":30,"page":600,"sajda":false,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","en":"And what can make you know what is the Striking Calamity?","tr":"Wa maa adraaka mal qaari'ah"},{"n":4,"global":6161,"juz":30,"page":600,"sajda":false,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","en":"It is the Day when people will be like moths, dispersed,","tr":"Yauma ya koonun naasu kal farashil mabthooth"},{"n":5,"global":6162,"juz":30,"page":600,"sajda":false,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","en":"And the mountains will be like wool, fluffed up.","tr":"Wa ta koonul jibalu kal 'ihnil manfoosh"},{"n":6,"global":6163,"juz":30,"page":600,"sajda":false,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","en":"Then as for one whose scales are heavy [with good deeds],","tr":"Fa-amma man thaqulat mawa zeenuh"},{"n":7,"global":6164,"juz":30,"page":600,"sajda":false,"ar":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","en":"He will be in a pleasant life.","tr":"Fahuwa fee 'ishatir raadiyah"},{"n":8,"global":6165,"juz":30,"page":600,"sajda":false,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","en":"But as for one whose scales are light,","tr":"Wa amma man khaffat mawa zeenuh"},{"n":9,"global":6166,"juz":30,"page":600,"sajda":false,"ar":"فَأُمُّهُۥ هَاوِيَةٌۭ","en":"His refuge will be an abyss.","tr":"Fa-ummuhu haawiyah"},{"n":10,"global":6167,"juz":30,"page":600,"sajda":false,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","en":"And what can make you know what that is?","tr":"Wa maa adraaka maa hiyah"},{"n":11,"global":6168,"juz":30,"page":600,"sajda":false,"ar":"نَارٌ حَامِيَةٌۢ","en":"It is a Fire, intensely hot.","tr":"Naarun hamiyah"}]}
