{"meta":{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","numberOfAyahs":4,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":6222,"juz":30,"page":604,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","en":"Say, \"He is Allah, [who is] One,","tr":"Qul huwal laahu ahad"},{"n":2,"global":6223,"juz":30,"page":604,"sajda":false,"ar":"ٱللَّهُ ٱلصَّمَدُ","en":"Allah, the Eternal Refuge.","tr":"Allah hus-samad"},{"n":3,"global":6224,"juz":30,"page":604,"sajda":false,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","en":"He neither begets nor is born,","tr":"Lam yalid wa lam yoolad"},{"n":4,"global":6225,"juz":30,"page":604,"sajda":false,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","en":"Nor is there to Him any equivalent.\"","tr":"Wa lam yakul-lahu kufuwan ahad"}]}
