{"meta":{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","numberOfAyahs":17,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":5932,"juz":30,"page":591,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","en":"By the sky and the night comer -","tr":"Wassamaaa'i wattaariq"},{"n":2,"global":5933,"juz":30,"page":591,"sajda":false,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","en":"And what can make you know what is the night comer?","tr":"Wa maaa adraaka mattaariq"},{"n":3,"global":5934,"juz":30,"page":591,"sajda":false,"ar":"ٱلنَّجْمُ ٱلثَّاقِبُ","en":"It is the piercing star -","tr":"Annajmus saaqib"},{"n":4,"global":5935,"juz":30,"page":591,"sajda":false,"ar":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","en":"There is no soul but that it has over it a protector.","tr":"In kullu nafsil lammaa 'alaihaa haafiz"},{"n":5,"global":5936,"juz":30,"page":591,"sajda":false,"ar":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","en":"So let man observe from what he was created.","tr":"Fal yanzuril insaanu mimma khuliq"},{"n":6,"global":5937,"juz":30,"page":591,"sajda":false,"ar":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","en":"He was created from a fluid, ejected,","tr":"Khuliqa mim maaa'in daafiq"},{"n":7,"global":5938,"juz":30,"page":591,"sajda":false,"ar":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","en":"Emerging from between the backbone and the ribs.","tr":"Yakhruju mim bainissulbi wat taraaa'ib"},{"n":8,"global":5939,"juz":30,"page":591,"sajda":false,"ar":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","en":"Indeed, Allah, to return him [to life], is Able.","tr":"Innahoo 'alaa raj'ihee laqaadir"},{"n":9,"global":5940,"juz":30,"page":591,"sajda":false,"ar":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","en":"The Day when secrets will be put on trial,","tr":"Yawma tublas saraaa'ir"},{"n":10,"global":5941,"juz":30,"page":591,"sajda":false,"ar":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","en":"Then man will have no power or any helper.","tr":"Famaa lahoo min quwwatinw wa laa naasir"},{"n":11,"global":5942,"juz":30,"page":591,"sajda":false,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","en":"By the sky which returns [rain]","tr":"Wassamaaa'i zaatir raj'"},{"n":12,"global":5943,"juz":30,"page":591,"sajda":false,"ar":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","en":"And [by] the earth which cracks open,","tr":"Wal ardi zaatis sad'"},{"n":13,"global":5944,"juz":30,"page":591,"sajda":false,"ar":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","en":"Indeed, the Qur'an is a decisive statement,","tr":"Innahoo laqawlun fasl"},{"n":14,"global":5945,"juz":30,"page":591,"sajda":false,"ar":"وَمَا هُوَ بِٱلْهَزْلِ","en":"And it is not amusement.","tr":"Wa maa huwa bil hazl"},{"n":15,"global":5946,"juz":30,"page":591,"sajda":false,"ar":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","en":"Indeed, they are planning a plan,","tr":"Innahum yakeedoona kaidaa"},{"n":16,"global":5947,"juz":30,"page":591,"sajda":false,"ar":"وَأَكِيدُ كَيْدًۭا","en":"But I am planning a plan.","tr":"Wa akeedu kaidaa"},{"n":17,"global":5948,"juz":30,"page":591,"sajda":false,"ar":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","en":"So allow time for the disbelievers. Leave them awhile.","tr":"Famahhilil kaafireena amhilhum ruwaidaa"}]}
