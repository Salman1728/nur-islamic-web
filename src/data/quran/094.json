{"meta":{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","numberOfAyahs":8,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":6091,"juz":30,"page":596,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","en":"Did We not expand for you, [O Muhammad], your breast?","tr":"Alam nashrah laka sadrak"},{"n":2,"global":6092,"juz":30,"page":596,"sajda":false,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","en":"And We removed from you your burden","tr":"Wa wa d'ana 'anka wizrak"},{"n":3,"global":6093,"juz":30,"page":596,"sajda":false,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","en":"Which had weighed upon your back","tr":"Allazee anqada zahrak"},{"n":4,"global":6094,"juz":30,"page":596,"sajda":false,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","en":"And raised high for you your repute.","tr":"Wa raf 'ana laka zikrak"},{"n":5,"global":6095,"juz":30,"page":596,"sajda":false,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","en":"For indeed, with hardship [will be] ease.","tr":"Fa inna ma'al usri yusra"},{"n":6,"global":6096,"juz":30,"page":596,"sajda":false,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","en":"Indeed, with hardship [will be] ease.","tr":"Inna ma'al 'usri yusra"},{"n":7,"global":6097,"juz":30,"page":596,"sajda":false,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","en":"So when you have finished [your duties], then stand up [for worship].","tr":"Fa iza faragh ta fansab"},{"n":8,"global":6098,"juz":30,"page":596,"sajda":false,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","en":"And to your Lord direct [your] longing.","tr":"Wa ilaa rabbika far ghab"}]}
