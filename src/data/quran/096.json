{"meta":{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","numberOfAyahs":19,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":6107,"juz":30,"page":597,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","en":"Recite in the name of your Lord who created -","tr":"Iqra bismi rab bikal lazee khalaq"},{"n":2,"global":6108,"juz":30,"page":597,"sajda":false,"ar":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","en":"Created man from a clinging substance.","tr":"Khalaqal insaana min 'alaq"},{"n":3,"global":6109,"juz":30,"page":597,"sajda":false,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","en":"Recite, and your Lord is the most Generous -","tr":"Iqra wa rab bukal akram"},{"n":4,"global":6110,"juz":30,"page":597,"sajda":false,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","en":"Who taught by the pen -","tr":"Al lazee 'allama bil qalam"},{"n":5,"global":6111,"juz":30,"page":597,"sajda":false,"ar":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","en":"Taught man that which he knew not.","tr":"'Al lamal insaana ma lam y'alam"},{"n":6,"global":6112,"juz":30,"page":597,"sajda":false,"ar":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","en":"No! [But] indeed, man transgresses","tr":"Kallaa innal insaana layatghaa"},{"n":7,"global":6113,"juz":30,"page":597,"sajda":false,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","en":"Because he sees himself self-sufficient.","tr":"Ar-ra aahus taghnaa"},{"n":8,"global":6114,"juz":30,"page":597,"sajda":false,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","en":"Indeed, to your Lord is the return.","tr":"Innna ilaa rabbikar ruj'aa"},{"n":9,"global":6115,"juz":30,"page":597,"sajda":false,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","en":"Have you seen the one who forbids","tr":"Ara-aital lazee yanhaa"},{"n":10,"global":6116,"juz":30,"page":597,"sajda":false,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","en":"A servant when he prays?","tr":"'Abdan iza sallaa"},{"n":11,"global":6117,"juz":30,"page":597,"sajda":false,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","en":"Have you seen if he is upon guidance","tr":"Ara-aita in kana 'alal hudaa"},{"n":12,"global":6118,"juz":30,"page":597,"sajda":false,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","en":"Or enjoins righteousness?","tr":"Au amara bit taqwaa"},{"n":13,"global":6119,"juz":30,"page":597,"sajda":false,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","en":"Have you seen if he denies and turns away -","tr":"Ara-aita in kaz zaba wa ta walla"},{"n":14,"global":6120,"juz":30,"page":597,"sajda":false,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","en":"Does he not know that Allah sees?","tr":"Alam y'alam bi-an nal lahaa yaraa"},{"n":15,"global":6121,"juz":30,"page":597,"sajda":false,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","en":"No! If he does not desist, We will surely drag him by the forelock -","tr":"Kalla la illam yantahi la nasfa'am bin nasiyah"},{"n":16,"global":6122,"juz":30,"page":597,"sajda":false,"ar":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","en":"A lying, sinning forelock.","tr":"Nasiyatin kazi batin khaatiyah"},{"n":17,"global":6123,"juz":30,"page":597,"sajda":false,"ar":"فَلْيَدْعُ نَادِيَهُۥ","en":"Then let him call his associates;","tr":"Fal yad'u naadiyah"},{"n":18,"global":6124,"juz":30,"page":597,"sajda":false,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","en":"We will call the angels of Hell.","tr":"Sanad 'uz zabaaniyah"},{"n":19,"global":6125,"juz":30,"page":597,"sajda":true,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","en":"No! Do not obey him. But prostrate and draw near [to Allah].","tr":"Kalla; la tuti'hu wasjud waqtarib"}]}
