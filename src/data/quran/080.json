{"meta":{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","numberOfAyahs":42,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":5759,"juz":30,"page":585,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","en":"The Prophet frowned and turned away","tr":"'Abasa wa tawallaa."},{"n":2,"global":5760,"juz":30,"page":585,"sajda":false,"ar":"أَن جَآءَهُ ٱلْأَعْمَىٰ","en":"Because there came to him the blind man, [interrupting].","tr":"An jaa-ahul 'a-maa"},{"n":3,"global":5761,"juz":30,"page":585,"sajda":false,"ar":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","en":"But what would make you perceive, [O Muhammad], that perhaps he might be purified","tr":"Wa maa yudreeka la'allahu yaz zakkaa."},{"n":4,"global":5762,"juz":30,"page":585,"sajda":false,"ar":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","en":"Or be reminded and the remembrance would benefit him?","tr":"Au yaz zak karu fatanfa 'ahuz zikraa."},{"n":5,"global":5763,"juz":30,"page":585,"sajda":false,"ar":"أَمَّا مَنِ ٱسْتَغْنَىٰ","en":"As for he who thinks himself without need,","tr":"Amma manis taghnaa"},{"n":6,"global":5764,"juz":30,"page":585,"sajda":false,"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","en":"To him you give attention.","tr":"Fa-anta lahu tasaddaa"},{"n":7,"global":5765,"juz":30,"page":585,"sajda":false,"ar":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","en":"And not upon you [is any blame] if he will not be purified.","tr":"Wa ma 'alaika allaa yaz zakka."},{"n":8,"global":5766,"juz":30,"page":585,"sajda":false,"ar":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","en":"But as for he who came to you striving [for knowledge]","tr":"Wa amma man jaa-aka yas'a"},{"n":9,"global":5767,"juz":30,"page":585,"sajda":false,"ar":"وَهُوَ يَخْشَىٰ","en":"While he fears [Allah],","tr":"Wahuwa yakhshaa,"},{"n":10,"global":5768,"juz":30,"page":585,"sajda":false,"ar":"فَأَنتَ عَنْهُ تَلَهَّىٰ","en":"From him you are distracted.","tr":"Fa-anta 'anhu talah haa."},{"n":11,"global":5769,"juz":30,"page":585,"sajda":false,"ar":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","en":"No! Indeed, these verses are a reminder;","tr":"Kalla innaha tazkirah"},{"n":12,"global":5770,"juz":30,"page":585,"sajda":false,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","en":"So whoever wills may remember it.","tr":"Faman shaa a zakarah"},{"n":13,"global":5771,"juz":30,"page":585,"sajda":false,"ar":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","en":"[It is recorded] in honored sheets,","tr":"Fi suhufim mukar rama,"},{"n":14,"global":5772,"juz":30,"page":585,"sajda":false,"ar":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","en":"Exalted and purified,","tr":"Marfoo'atim mutah hara,"},{"n":15,"global":5773,"juz":30,"page":585,"sajda":false,"ar":"بِأَيْدِى سَفَرَةٍۢ","en":"[Carried] by the hands of messenger-angels,","tr":"Bi'aidee safara"},{"n":16,"global":5774,"juz":30,"page":585,"sajda":false,"ar":"كِرَامٍۭ بَرَرَةٍۢ","en":"Noble and dutiful.","tr":"Kiraamim bararah."},{"n":17,"global":5775,"juz":30,"page":585,"sajda":false,"ar":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","en":"Cursed is man; how disbelieving is he.","tr":"Qutilal-insanu maa akfarah."},{"n":18,"global":5776,"juz":30,"page":585,"sajda":false,"ar":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","en":"From what substance did He create him?","tr":"Min aiyyi shai-in Khalaq"},{"n":19,"global":5777,"juz":30,"page":585,"sajda":false,"ar":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","en":"From a sperm-drop He created him and destined for him;","tr":"Min nutfah; khalaqahu faqad-darah."},{"n":20,"global":5778,"juz":30,"page":585,"sajda":false,"ar":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","en":"Then He eased the way for him;","tr":"Thummas sabeela yas-sarah"},{"n":21,"global":5779,"juz":30,"page":585,"sajda":false,"ar":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","en":"Then He causes his death and provides a grave for him.","tr":"Thumma amatahu fa-aqbarah"},{"n":22,"global":5780,"juz":30,"page":585,"sajda":false,"ar":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","en":"Then when He wills, He will resurrect him.","tr":"Thumma iza shaa-a ansharah"},{"n":23,"global":5781,"juz":30,"page":585,"sajda":false,"ar":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","en":"No! Man has not yet accomplished what He commanded him.","tr":"Kalla lamma yaqdi maa amarah."},{"n":24,"global":5782,"juz":30,"page":585,"sajda":false,"ar":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","en":"Then let mankind look at his food -","tr":"Falyanzuril insanu ilaa ta-amih"},{"n":25,"global":5783,"juz":30,"page":585,"sajda":false,"ar":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","en":"How We poured down water in torrents,","tr":"Anna sabab nalmaa-a sabba."},{"n":26,"global":5784,"juz":30,"page":585,"sajda":false,"ar":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","en":"Then We broke open the earth, splitting [it with sprouts],","tr":"Thumma sha qaqnal-arda shaqqa."},{"n":27,"global":5785,"juz":30,"page":585,"sajda":false,"ar":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","en":"And caused to grow within it grain","tr":"Fa ambatna feeha habba"},{"n":28,"global":5786,"juz":30,"page":585,"sajda":false,"ar":"وَعِنَبًۭا وَقَضْبًۭا","en":"And grapes and herbage","tr":"Wa 'inabaw-wa qadba"},{"n":29,"global":5787,"juz":30,"page":585,"sajda":false,"ar":"وَزَيْتُونًۭا وَنَخْلًۭا","en":"And olive and palm trees","tr":"Wa zaitoonaw wanakh la'"},{"n":30,"global":5788,"juz":30,"page":585,"sajda":false,"ar":"وَحَدَآئِقَ غُلْبًۭا","en":"And gardens of dense shrubbery","tr":"Wa hadaa-iqa ghulba"},{"n":31,"global":5789,"juz":30,"page":585,"sajda":false,"ar":"وَفَٰكِهَةًۭ وَأَبًّۭا","en":"And fruit and grass -","tr":"Wa faki hataw-wa abba."},{"n":32,"global":5790,"juz":30,"page":585,"sajda":false,"ar":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","en":"[As] enjoyment for you and your grazing livestock.","tr":"Mata'al-lakum wa li-an'amikum."},{"n":33,"global":5791,"juz":30,"page":585,"sajda":false,"ar":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","en":"But when there comes the Deafening Blast","tr":"Faiza jaa-atis saakhah."},{"n":34,"global":5792,"juz":30,"page":585,"sajda":false,"ar":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","en":"On the Day a man will flee from his brother","tr":"Yauma yafir-rul mar-u min akheeh"},{"n":35,"global":5793,"juz":30,"page":585,"sajda":false,"ar":"وَأُمِّهِۦ وَأَبِيهِ","en":"And his mother and his father","tr":"Wa ummihee wa abeeh"},{"n":36,"global":5794,"juz":30,"page":585,"sajda":false,"ar":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","en":"And his wife and his children,","tr":"Wa sahi batihee wa baneeh."},{"n":37,"global":5795,"juz":30,"page":585,"sajda":false,"ar":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","en":"For every man, that Day, will be a matter adequate for him.","tr":"Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh"},{"n":38,"global":5796,"juz":30,"page":585,"sajda":false,"ar":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","en":"[Some] faces, that Day, will be bright -","tr":"Wujoo huny-yauma-izim-musfira;"},{"n":39,"global":5797,"juz":30,"page":585,"sajda":false,"ar":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","en":"Laughing, rejoicing at good news.","tr":"Dahi katum mustab shirah"},{"n":40,"global":5798,"juz":30,"page":585,"sajda":false,"ar":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","en":"And [other] faces, that Day, will have upon them dust.","tr":"Wa wujoohuy yauma-izin 'alaiha ghabar a"},{"n":41,"global":5799,"juz":30,"page":585,"sajda":false,"ar":"تَرْهَقُهَا قَتَرَةٌ","en":"Blackness will cover them.","tr":"Tarhaquha qatarah."},{"n":42,"global":5800,"juz":30,"page":585,"sajda":false,"ar":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","en":"Those are the disbelievers, the wicked ones.","tr":"Ulaa-ika humul-kafa ratul-fajarah."}]}
