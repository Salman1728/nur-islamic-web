{"meta":{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","numberOfAyahs":6,"revelationType":"Meccan"},"ayahs":[{"n":1,"global":6208,"juz":30,"page":603,"sajda":false,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","en":"Say, \"O disbelievers,","tr":"Qul yaa-ai yuhal kaafiroon"},{"n":2,"global":6209,"juz":30,"page":603,"sajda":false,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","en":"I do not worship what you worship.","tr":"Laa a'budu ma t'abudoon"},{"n":3,"global":6210,"juz":30,"page":603,"sajda":false,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","en":"Nor are you worshippers of what I worship.","tr":"Wa laa antum 'aabidoona maa a'bud"},{"n":4,"global":6211,"juz":30,"page":603,"sajda":false,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","en":"Nor will I be a worshipper of what you worship.","tr":"Wa laa ana 'abidum maa 'abattum"},{"n":5,"global":6212,"juz":30,"page":603,"sajda":false,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","en":"Nor will you be worshippers of what I worship.","tr":"Wa laa antum 'aabidoona ma a'bud"},{"n":6,"global":6213,"juz":30,"page":603,"sajda":false,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","en":"For you is your religion, and for me is my religion.\"","tr":"Lakum deenukum wa liya deen."}]}
